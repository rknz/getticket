{
  "manifest_version": 3,
  "name": "GeTicket - Bangladesh Railway Pro Fast Booking",
  "version": "1.0.0",
  "author": "Rukonuzzaman <rukonuzzaman.dev@gmail.com>",
  "homepage_url": "mailto:rukonuzzaman.dev@gmail.com",
  "description": "Ultra-fast, 100% humanized, zero-ban railway automation extension for PC Chrome & Mobile Kiwi Browser.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "GeTicket Pro Control Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://eticket.railway.gov.bd/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://eticket.railway.gov.bd/*"],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://eticket.railway.gov.bd/*"]
    }
  ]
}
